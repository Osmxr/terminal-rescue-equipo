# Base de datos del cierre
POSTGRES_DB=cierre
POSTGRES_USER=cierre
POSTGRES_PASSWORD=cambiar-clave-local

# Conexión usada por cierre-api y cierre-worker
# (el host es el NOMBRE DEL SERVICIO en docker-compose.yml: cierre-db)
DATABASE_HOST=cierre-db
DATABASE_PORT=5432
DATABASE_NAME=cierre
DATABASE_USER=cierre
DATABASE_PASSWORD=cambiar-clave-local

# API de consulta
API_PORT=8081

# Worker de conciliación (entero, en segundos; sin sufijo "s")
WORKER_INTERVAL_SECONDS=30
